5. /* finding the greatest number from 2 numbers
*/
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int a = obj.nextInt();
	    int b = obj.nextInt();
	    if(a<b)
		System.out.println(b +" is greater number");
		else

2. /*checking the given num is even or odd
*/
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int num = obj.nextInt();
	    if(num%2==0)
		System.out.println(num +" the given num is even");
		else
		System.out.println(num +" the given num is odd");
	}
}




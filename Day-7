/*armstromg number*/
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj  = new Scanner(System.in);
	    
	    int n = obj.nextInt();
	    int temp=n,c=0,d,sum=0;
	    while(n!=0){
	        d=n%10;
	        c++;
	        n=n/10;
	    }
	    n=temp;
	    while(n!=0){
	        d=n%10;
	        sum=sum+(int)Math.pow(d,c);
	        n=n/10;
	    }
	    if(temp==sum)
	    System.out.println("armstromg number");
	    else
		System.out.println("not a armstromg number");
	}
}




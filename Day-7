/*amicable number*/
import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner obj = new Scanner(System.in);

        int a = obj.nextInt();
        int b = obj.nextInt();

        int sum1 = 0, sum2 = 0;

        // Sum of proper divisors of a
        for (int i = 1; i < a; i++) {
            if (a % i == 0) {
                sum1 = sum1 + i;
            }
        }

        // Sum of proper divisors of b
        for (int i = 1; i < b; i++) {
            if (b % i == 0) {
                sum2 = sum2 + i;
            }
        }

        if (sum1 == b && sum2 == a)
            System.out.println("Amicable Numbers");
        else
            System.out.println("Not Amicable Numbers");
    }
}
